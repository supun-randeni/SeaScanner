all:
	@echo "Installing distribution non-specific dependencies"
	@apt-get update
	@apt-get install \
		gpp \
		cmake \
		build-essential \
		libprotobuf-dev \
		protobuf-compiler \
		-y


ubuntu: all
	@echo "Installing Ubuntu specific dependencies"

focal: bionic
	@echo "Installing bionic specific dependencies"

bionic: ubuntu
	@echo "Installing bionic specific dependencies"

xenial: ubuntu
	@echo "Installing xenial specific dependencies"

jessie: ubuntu
	@echo "Installing jessie specific dependencies"

stretch: all
	@echo "Installing Debian specific dependencies"
